# Doxygen configuration for the NativeWeb plugin's source API.

PROJECT_NAME           = "NativeWeb"
PROJECT_BRIEF          = "Unreal Engine native web runtime and networking modules"
OUTPUT_DIRECTORY       = Intermediate/Doxygen
INPUT                  = Source README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp *.cs *.md
EXTENSION_MAPPING      = .cs=C#
USE_MDFILE_AS_MAINPAGE  = README.md

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_LATEX          = NO
# Keep the top navigation tabs and expandable tree sidebar visible together.
DISABLE_INDEX            = NO
GENERATE_TREEVIEW       = YES
FULL_SIDEBAR             = YES

EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = YES
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES    = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_INCOMPLETE_DOC  = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = NO
JAVADOC_AUTOBRIEF       = NO
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
QUIET                   = YES
WARNINGS                = YES

EXCLUDE_PATTERNS        = */Binaries/* */Intermediate/* */Saved/* */DerivedDataCache/*
