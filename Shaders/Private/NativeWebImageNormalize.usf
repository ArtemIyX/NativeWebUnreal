#include "/Engine/Public/Platform.ush"

Texture2D SourceTexture;
SamplerState SourceSampler;
RWTexture2D<float4> OutputTexture;
int2 OutputSize;

float3 LinearToSrgb(float3 Value)
{
	Value = saturate(Value);
	float3 Low = Value * 12.92;
	float3 High = 1.055 * pow(Value, 1.0 / 2.4) - 0.055;
	return lerp(High, Low, Value <= 0.0031308);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= OutputSize.x || DispatchThreadId.y >= OutputSize.y)
	{
		return;
	}
	float2 UV = (float2(DispatchThreadId.xy) + 0.5) / float2(OutputSize);
	float4 Sample = SourceTexture.SampleLevel(SourceSampler, UV, 0.0);
	OutputTexture[DispatchThreadId.xy] = float4(LinearToSrgb(Sample.rgb), saturate(Sample.a));
}
